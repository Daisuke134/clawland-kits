{
  "title": "Greenhouse Pro Overview",
  "tags": [
    "greenhouse",
    "picoclaw",
    "clawland"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device_id",
        "type": "textbox",
        "label": "Device ID",
        "query": "greenhouse-pro-01",
        "current": {
          "text": "greenhouse-pro-01",
          "value": "greenhouse-pro-01"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Air Temperature / Humidity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "humidity_percent"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greenhouse_air_temp_c{device_id=\"$device_id\"}"
        },
        {
          "refId": "B",
          "expr": "greenhouse_humidity_percent{device_id=\"$device_id\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Soil Moisture / Soil Temperature",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "soil_temp_c"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greenhouse_soil_moisture_percent{device_id=\"$device_id\"}"
        },
        {
          "refId": "B",
          "expr": "greenhouse_soil_temp_c{device_id=\"$device_id\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "CO2 Estimate",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 400
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greenhouse_co2_ppm{device_id=\"$device_id\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Light Level",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lux"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greenhouse_light_lux{device_id=\"$device_id\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Actuator Timeline",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "greenhouse_actuator_state{device_id=\"$device_id\"}"
        }
      ]
    }
  ]
}
